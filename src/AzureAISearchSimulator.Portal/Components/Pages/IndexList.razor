@page "/indexes"
@inject SearchSimulatorApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Indexes - Azure AI Search Simulator</PageTitle>

<div class="page-header">
    <h1>Indexes</h1>
    <div class="page-toolbar">
        <FluentButton Appearance="Appearance.Accent" OnClick="@(() => _showCreate = true)"
                      IconStart="@(new RegularIcons.Size16.Add())">Add index</FluentButton>
        <FluentButton Appearance="Appearance.Outline" OnClick="@LoadDataAsync"
                      IconStart="@(new RegularIcons.Size16.ArrowClockwise())">Refresh</FluentButton>
    </div>
</div>

@if (_loading)
{
    <div class="loading-container">
        <FluentProgressRing />
        <span>Loading indexes...</span>
    </div>
}
else if (!_indexes.Any())
{
    <div class="empty-state">
        <FluentIcon Value="@(new RegularIcons.Size48.TableSimple())" Color="Color.Neutral" />
        <h3>No indexes</h3>
        <p>No indexes have been created yet. Click "Add index" to create one.</p>
    </div>
}
else
{
    <FluentDataGrid Items="@_indexData.AsQueryable()" GridTemplateColumns="1fr 120px 120px 120px 60px" Style="width:100%;">
        <TemplateColumn Title="Name">
            <FluentAnchor Href="@($"/indexes/{context.Name}")" Appearance="Appearance.Hypertext">@context.Name</FluentAnchor>
        </TemplateColumn>
        <PropertyColumn Property="@(i => i.DocumentCount)" Title="Documents" Align="Align.End" />
        <PropertyColumn Property="@(i => FormatBytes(i.StorageSize))" Title="Storage size" Align="Align.End" />
        <PropertyColumn Property="@(i => i.FieldCount)" Title="Fields" Align="Align.End" />
        <TemplateColumn Title="" Align="Align.Center">
            <FluentButton Appearance="Appearance.Stealth" Title="Delete"
                          OnClick="@(() => ConfirmDelete(context.Name))"
                          IconStart="@(new RegularIcons.Size16.Delete())" />
        </TemplateColumn>
    </FluentDataGrid>
}

@* ── Create Index Dialog ── *@
<FluentDialog @bind-Hidden="@_hideCreate" Modal="true" TrapFocus="true" PreventScroll="true">
    <FluentDialogHeader>Add index (JSON)</FluentDialogHeader>
    <FluentDialogBody>
        <FluentTextArea @bind-Value="_createJson" Rows="15"
                        Style="width: 100%; font-family: Consolas, monospace; font-size: 13px;"
                        Placeholder='{ "name": "my-index", "fields": [...] }' />
        @if (!string.IsNullOrEmpty(_createError))
        {
            <FluentMessageBar Intent="MessageIntent.Error" Style="margin-top: 8px;">@_createError</FluentMessageBar>
        }
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Accent" OnClick="CreateIndexAsync">Create</FluentButton>
        <FluentButton Appearance="Appearance.Outline" OnClick="@(() => _showCreate = false)">Cancel</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

@* ── Delete Confirmation Dialog ── *@
<FluentDialog @bind-Hidden="@_hideDelete" Modal="true" TrapFocus="true">
    <FluentDialogHeader>Delete index</FluentDialogHeader>
    <FluentDialogBody>
        <p>Are you sure you want to delete index <strong>@_deleteTarget</strong>? This action cannot be undone.</p>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Accent" OnClick="DeleteIndexAsync"
                      style="background: #a80000; border-color: #a80000;">Delete</FluentButton>
        <FluentButton Appearance="Appearance.Outline" OnClick="@(() => _showDelete = false)">Cancel</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

@if (!string.IsNullOrEmpty(_error))
{
    <FluentMessageBar Intent="MessageIntent.Error" Title="Error">@_error</FluentMessageBar>
}

@code {
    private bool _loading = true;
    private string? _error;
    private List<SearchIndexModel> _indexes = [];
    private List<IndexRow> _indexData = [];

    // Create dialog
    private bool _showCreate;
    private bool _hideCreate { get => !_showCreate; set => _showCreate = !value; }
    private string _createJson = "";
    private string? _createError;

    // Delete dialog
    private bool _showDelete;
    private bool _hideDelete { get => !_showDelete; set => _showDelete = !value; }
    private string? _deleteTarget;

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            _indexes = await ApiClient.ListIndexesAsync();
            _indexData.Clear();

            foreach (var idx in _indexes)
            {
                var stats = await ApiClient.GetIndexStatsAsync(idx.Name);
                _indexData.Add(new IndexRow
                {
                    Name = idx.Name,
                    DocumentCount = stats?.DocumentCount ?? 0,
                    StorageSize = stats?.StorageSize ?? 0,
                    FieldCount = idx.Fields?.Count ?? 0
                });
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to load indexes: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateIndexAsync()
    {
        _createError = null;
        if (string.IsNullOrWhiteSpace(_createJson))
        {
            _createError = "Please enter the index JSON definition.";
            return;
        }

        try
        {
            var success = await ApiClient.CreateIndexAsync(_createJson);
            if (success)
            {
                _showCreate = false;
                _createJson = "";
                await LoadDataAsync();
            }
            else
            {
                _createError = "Failed to create index. Check the JSON definition.";
            }
        }
        catch (Exception ex)
        {
            _createError = ex.Message;
        }
    }

    private void ConfirmDelete(string name)
    {
        _deleteTarget = name;
        _showDelete = true;
    }

    private async Task DeleteIndexAsync()
    {
        if (string.IsNullOrEmpty(_deleteTarget)) return;

        try
        {
            await ApiClient.DeleteIndexAsync(_deleteTarget);
            _showDelete = false;
            _deleteTarget = null;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to delete: {ex.Message}";
            _showDelete = false;
        }
    }

    private string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024.0):F1} MB";
        return $"{bytes / (1024.0 * 1024.0 * 1024.0):F2} GB";
    }

    private class IndexRow
    {
        public string Name { get; set; } = string.Empty;
        public long DocumentCount { get; set; }
        public long StorageSize { get; set; }
        public int FieldCount { get; set; }
    }
}
