@page "/skillsets/{Name}"
@inject SearchSimulatorApiClient ApiClient
@inject NavigationManager Navigation
@using System.Text.Json

<PageTitle>@Name - Skillset - Azure AI Search Simulator</PageTitle>

<div class="page-header">
    <h1>@Name</h1>
    <div class="page-toolbar">
        <FluentButton Appearance="Appearance.Outline" OnClick="@LoadDataAsync"
                      IconStart="@(new RegularIcons.Size16.ArrowClockwise())">Refresh</FluentButton>
        <FluentButton Appearance="Appearance.Outline" OnClick="@ConfirmDelete"
                      IconStart="@(new RegularIcons.Size16.Delete())"
                      style="color: #a80000;">Delete</FluentButton>
    </div>
</div>

@if (_loading)
{
    <div class="loading-container">
        <FluentProgressRing />
        <span>Loading skillset...</span>
    </div>
}
else if (_skillset == null)
{
    <div class="empty-state">
        <h3>Skillset not found</h3>
        <p>The skillset "@Name" was not found.</p>
        <FluentButton Appearance="Appearance.Accent" OnClick="@(() => Navigation.NavigateTo("/skillsets"))">Back to skillsets</FluentButton>
    </div>
}
else
{
    @* ── Essentials ── *@
    <div class="essentials-panel">
        <div class="essentials-grid">
            <div class="essentials-item">
                <span class="essentials-label">Name</span>
                <span class="essentials-value">@_skillset.Name</span>
            </div>
            <div class="essentials-item">
                <span class="essentials-label">Description</span>
                <span class="essentials-value">@(_skillset.Description ?? "—")</span>
            </div>
            <div class="essentials-item">
                <span class="essentials-label">Skills count</span>
                <span class="essentials-value">@_skillset.Skills.Count</span>
            </div>
        </div>
    </div>

    @* ── Tabs ── *@
    <FluentTabs @bind-ActiveTabId="_activeTab">
        <FluentTab Label="Skills" Id="skills">
            <div style="margin-top: 16px;">
                @if (_skillset.Skills.Any())
                {
                    <FluentDataGrid Items="@_skillset.Skills.AsQueryable()"
                                    GridTemplateColumns="1fr 1fr 1fr 1fr"
                                    Style="width: 100%;">
                        <PropertyColumn Property="@(s => s.Name ?? "—")" Title="Name" />
                        <PropertyColumn Property="@(s => FormatSkillType(s.ODataType))" Title="Type" />
                        <PropertyColumn Property="@(s => s.Context ?? "—")" Title="Context" />
                        <PropertyColumn Property="@(s => s.Description ?? "—")" Title="Description" />
                    </FluentDataGrid>

                    @* ── Skill Detail Accordion ── *@
                    <div style="margin-top: 16px;">
                        <FluentAccordion>
                            @foreach (var skill in _skillset.Skills)
                            {
                                <FluentAccordionItem Heading="@($"{skill.Name ?? FormatSkillType(skill.ODataType)}")">
                                    <div style="padding: 8px 0;">
                                        <div class="detail-row">
                                            <span class="detail-label">Type</span>
                                            <span class="detail-value">@skill.ODataType</span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="detail-label">Context</span>
                                            <span class="detail-value">@(skill.Context ?? "—")</span>
                                        </div>

                                        @if (skill.Inputs != null && skill.Inputs.Any())
                                        {
                                            <h4 style="margin-top: 12px; font-size: 13px;">Inputs</h4>
                                            @foreach (var input in skill.Inputs)
                                            {
                                                <div class="detail-row">
                                                    <span class="detail-label">@input.Name</span>
                                                    <span class="detail-value" style="font-family: Consolas, monospace; font-size: 12px;">@(input.Source ?? "—")</span>
                                                </div>
                                            }
                                        }

                                        @if (skill.Outputs != null && skill.Outputs.Any())
                                        {
                                            <h4 style="margin-top: 12px; font-size: 13px;">Outputs</h4>
                                            @foreach (var output in skill.Outputs)
                                            {
                                                <div class="detail-row">
                                                    <span class="detail-label">@output.Name</span>
                                                    <span class="detail-value" style="font-family: Consolas, monospace; font-size: 12px;">@(output.TargetName ?? "—")</span>
                                                </div>
                                            }
                                        }
                                    </div>
                                </FluentAccordionItem>
                            }
                        </FluentAccordion>
                    </div>
                }
                else
                {
                    <p style="color: #605e5c;">No skills defined in this skillset.</p>
                }
            </div>
        </FluentTab>

        <FluentTab Label="JSON definition" Id="json">
            <div style="margin-top: 16px;">
                <div class="json-viewer">@_rawJson</div>
            </div>
        </FluentTab>
    </FluentTabs>
}

@* ── Delete Confirmation ── *@
<FluentDialog @bind-Hidden="@_hideDelete" Modal="true" TrapFocus="true">
    <FluentDialogHeader>Delete skillset</FluentDialogHeader>
    <FluentDialogBody>
        <p>Are you sure you want to delete skillset <strong>@Name</strong>?</p>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Accent" OnClick="DeleteAsync"
                      style="background: #a80000; border-color: #a80000;">Delete</FluentButton>
        <FluentButton Appearance="Appearance.Outline" OnClick="@(() => _showDelete = false)">Cancel</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

@if (!string.IsNullOrEmpty(_error))
{
    <FluentMessageBar Intent="MessageIntent.Error" Title="Error">@_error</FluentMessageBar>
}

@code {
    [Parameter] public string Name { get; set; } = string.Empty;

    private bool _loading = true;
    private string? _error;
    private SkillsetModel? _skillset;
    private string? _rawJson;
    private string _activeTab = "skills";

    private bool _showDelete;
    private bool _hideDelete { get => !_showDelete; set => _showDelete = !value; }

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            _skillset = await ApiClient.GetSkillsetAsync(Name);

            var raw = await ApiClient.GetRawJsonAsync($"/skillsets/{Name}");
            try
            {
                var doc = JsonDocument.Parse(raw);
                _rawJson = JsonSerializer.Serialize(doc, new JsonSerializerOptions { WriteIndented = true });
            }
            catch { _rawJson = raw; }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ConfirmDelete() => _showDelete = true;

    private async Task DeleteAsync()
    {
        try
        {
            await ApiClient.DeleteSkillsetAsync(Name);
            Navigation.NavigateTo("/skillsets");
        }
        catch (Exception ex)
        {
            _error = $"Failed to delete: {ex.Message}";
            _showDelete = false;
        }
    }

    private string FormatSkillType(string odataType)
    {
        if (string.IsNullOrEmpty(odataType)) return "Unknown";
        // "#Microsoft.Skills.Text.EntityRecognitionSkill" -> "Entity Recognition"
        var parts = odataType.Split('.');
        var name = parts.LastOrDefault() ?? odataType;
        name = name.Replace("Skill", "");
        // Insert spaces before capitals
        var result = System.Text.RegularExpressions.Regex.Replace(name, "([A-Z])", " $1").Trim();
        return result;
    }
}
