@page "/indexers/{Name}"
@inject SearchSimulatorApiClient ApiClient
@inject NavigationManager Navigation
@using System.Text.Json

<PageTitle>@Name - Indexer - Azure AI Search Simulator</PageTitle>

<div class="page-header">
    <h1>@Name</h1>
    <div class="page-toolbar">
        <FluentButton Appearance="Appearance.Accent" OnClick="@RunIndexerAsync"
                      IconStart="@(new RegularIcons.Size16.Play())" Disabled="@_running">Run</FluentButton>
        <FluentButton Appearance="Appearance.Outline" OnClick="@ResetIndexerAsync"
                      IconStart="@(new RegularIcons.Size16.ArrowCounterclockwise())">Reset</FluentButton>
        <FluentButton Appearance="Appearance.Outline" OnClick="@LoadDataAsync"
                      IconStart="@(new RegularIcons.Size16.ArrowClockwise())">Refresh</FluentButton>
        <FluentButton Appearance="Appearance.Outline" OnClick="@ConfirmDelete"
                      IconStart="@(new RegularIcons.Size16.Delete())"
                      style="color: #a80000;">Delete</FluentButton>
    </div>
</div>

@if (_loading)
{
    <div class="loading-container">
        <FluentProgressRing />
        <span>Loading indexer...</span>
    </div>
}
else if (_indexer == null)
{
    <div class="empty-state">
        <h3>Indexer not found</h3>
        <p>The indexer "@Name" was not found.</p>
        <FluentButton Appearance="Appearance.Accent" OnClick="@(() => Navigation.NavigateTo("/indexers"))">Back to indexers</FluentButton>
    </div>
}
else
{
    @* ── Essentials ── *@
    <div class="essentials-panel">
        <div class="essentials-grid">
            <div class="essentials-item">
                <span class="essentials-label">Target index</span>
                <span class="essentials-value">
                    @if (!string.IsNullOrEmpty(_indexer.TargetIndexName))
                    {
                        <FluentAnchor Href="@($"/indexes/{_indexer.TargetIndexName}")" Appearance="Appearance.Hypertext">@_indexer.TargetIndexName</FluentAnchor>
                    }
                    else { <span>—</span> }
                </span>
            </div>
            <div class="essentials-item">
                <span class="essentials-label">Data source</span>
                <span class="essentials-value">
                    @if (!string.IsNullOrEmpty(_indexer.DataSourceName))
                    {
                        <FluentAnchor Href="@($"/data-sources/{_indexer.DataSourceName}")" Appearance="Appearance.Hypertext">@_indexer.DataSourceName</FluentAnchor>
                    }
                    else { <span>—</span> }
                </span>
            </div>
            <div class="essentials-item">
                <span class="essentials-label">Skillset</span>
                <span class="essentials-value">
                    @if (!string.IsNullOrEmpty(_indexer.SkillsetName))
                    {
                        <FluentAnchor Href="@($"/skillsets/{_indexer.SkillsetName}")" Appearance="Appearance.Hypertext">@_indexer.SkillsetName</FluentAnchor>
                    }
                    else { <span>—</span> }
                </span>
            </div>
            <div class="essentials-item">
                <span class="essentials-label">Schedule</span>
                <span class="essentials-value">@(_indexer.Schedule?.Interval ?? "None")</span>
            </div>
            @if (_status != null)
            {
                <div class="essentials-item">
                    <span class="essentials-label">Status</span>
                    <span class="essentials-value">
                        <span class="status-badge @GetStatusClass(_status.Status)">@_status.Status</span>
                    </span>
                </div>
            }
        </div>
    </div>

    @* ── Tabs ── *@
    <FluentTabs @bind-ActiveTabId="_activeTab">
        <FluentTab Label="Execution history" Id="history">
            <div style="margin-top: 16px;">
                @if (_status?.ExecutionHistory != null && _status.ExecutionHistory.Any())
                {
                    <FluentDataGrid Items="@_status.ExecutionHistory.AsQueryable()"
                                    GridTemplateColumns="120px 180px 180px 100px 100px"
                                    Style="width: 100%;">
                        <TemplateColumn Title="Status">
                            <span class="status-badge @GetStatusClass(context.Status)">@context.Status</span>
                        </TemplateColumn>
                        <PropertyColumn Property="@(e => e.StartTime ?? "—")" Title="Start time" />
                        <PropertyColumn Property="@(e => e.EndTime ?? "—")" Title="End time" />
                        <PropertyColumn Property="@(e => e.ItemsProcessed)" Title="Processed" Align="Align.End" />
                        <PropertyColumn Property="@(e => e.ItemsFailed)" Title="Failed" Align="Align.End" />
                    </FluentDataGrid>
                }
                else
                {
                    <p style="color: #605e5c;">No execution history available.</p>
                }
            </div>
        </FluentTab>

        <FluentTab Label="Field mappings" Id="mappings">
            <div style="margin-top: 16px;">
                <h3>Field mappings</h3>
                @if (_indexer.FieldMappings != null && _indexer.FieldMappings.Any())
                {
                    <FluentDataGrid Items="@_indexer.FieldMappings.AsQueryable()" Style="width: 100%;">
                        <PropertyColumn Property="@(m => m.SourceFieldName)" Title="Source field" />
                        <PropertyColumn Property="@(m => m.TargetFieldName ?? m.SourceFieldName)" Title="Target field" />
                    </FluentDataGrid>
                }
                else
                {
                    <p style="color: #605e5c;">No field mappings defined.</p>
                }

                <h3 style="margin-top: 20px;">Output field mappings</h3>
                @if (_indexer.OutputFieldMappings != null && _indexer.OutputFieldMappings.Any())
                {
                    <FluentDataGrid Items="@_indexer.OutputFieldMappings.AsQueryable()" Style="width: 100%;">
                        <PropertyColumn Property="@(m => m.SourceFieldName)" Title="Source field" />
                        <PropertyColumn Property="@(m => m.TargetFieldName ?? m.SourceFieldName)" Title="Target field" />
                    </FluentDataGrid>
                }
                else
                {
                    <p style="color: #605e5c;">No output field mappings defined.</p>
                }
            </div>
        </FluentTab>

        <FluentTab Label="JSON definition" Id="json">
            <div style="margin-top: 16px;">
                <div class="json-viewer">@_rawJson</div>
            </div>
        </FluentTab>
    </FluentTabs>
}

@* ── Delete Confirmation ── *@
<FluentDialog @bind-Hidden="@_hideDelete" Modal="true" TrapFocus="true">
    <FluentDialogHeader>Delete indexer</FluentDialogHeader>
    <FluentDialogBody>
        <p>Are you sure you want to delete indexer <strong>@Name</strong>?</p>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Accent" OnClick="DeleteAsync"
                      style="background: #a80000; border-color: #a80000;">Delete</FluentButton>
        <FluentButton Appearance="Appearance.Outline" OnClick="@(() => _showDelete = false)">Cancel</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

@if (!string.IsNullOrEmpty(_error))
{
    <FluentMessageBar Intent="MessageIntent.Error" Title="Error">@_error</FluentMessageBar>
}

@code {
    [Parameter] public string Name { get; set; } = string.Empty;

    private bool _loading = true;
    private bool _running;
    private string? _error;
    private IndexerModel? _indexer;
    private IndexerStatusModel? _status;
    private string? _rawJson;
    private string _activeTab = "history";

    private bool _showDelete;
    private bool _hideDelete { get => !_showDelete; set => _showDelete = !value; }

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            _indexer = await ApiClient.GetIndexerAsync(Name);
            _status = await ApiClient.GetIndexerStatusAsync(Name);

            var raw = await ApiClient.GetRawJsonAsync($"/indexers/{Name}");
            try
            {
                var doc = JsonDocument.Parse(raw);
                _rawJson = JsonSerializer.Serialize(doc, new JsonSerializerOptions { WriteIndented = true });
            }
            catch { _rawJson = raw; }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RunIndexerAsync()
    {
        _running = true;
        _error = null;
        StateHasChanged();

        try
        {
            var ok = await ApiClient.RunIndexerAsync(Name);
            if (!ok) _error = "Failed to run indexer.";
            else await LoadDataAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _running = false; }
    }

    private async Task ResetIndexerAsync()
    {
        try
        {
            var ok = await ApiClient.ResetIndexerAsync(Name);
            if (!ok) _error = "Failed to reset indexer.";
            else await LoadDataAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void ConfirmDelete() => _showDelete = true;

    private async Task DeleteAsync()
    {
        try
        {
            await ApiClient.DeleteIndexerAsync(Name);
            Navigation.NavigateTo("/indexers");
        }
        catch (Exception ex)
        {
            _error = $"Failed to delete: {ex.Message}";
            _showDelete = false;
        }
    }

    private string GetStatusClass(string status) => status.ToLowerInvariant() switch
    {
        "success" => "status-success",
        "inprogress" or "running" => "status-info",
        "error" or "transientfailure" => "status-error",
        _ => "status-warning"
    };
}
