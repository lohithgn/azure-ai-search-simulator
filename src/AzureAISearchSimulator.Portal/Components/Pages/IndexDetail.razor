@page "/indexes/{Name}"
@inject SearchSimulatorApiClient ApiClient
@inject NavigationManager Navigation
@using System.Text.Json
@using System.Text.RegularExpressions

<PageTitle>@Name - Index - Azure AI Search Simulator</PageTitle>

@* ── Index Name Header ── *@
<div class="idx-header">
    <h1 class="idx-title">@Name</h1>
    <span class="idx-ellipsis" title="More options">⋯</span>
</div>

@* ── Command Bar ── *@
<div class="idx-commandbar">
    <FluentButton Appearance="Appearance.Stealth" OnClick="@LoadDataAsync"
                  IconStart="@(new RegularIcons.Size16.ArrowClockwise())" Class="cmd-btn">Refresh</FluentButton>
    <span class="cmd-divider"></span>
    <FluentButton Appearance="Appearance.Stealth" OnClick="@(() => { _activeTab = "json"; })"
                  IconStart="@(new RegularIcons.Size16.Code())" Class="cmd-btn">Edit JSON</FluentButton>
    <FluentButton Appearance="Appearance.Stealth" OnClick="@ConfirmDelete"
                  IconStart="@(new RegularIcons.Size16.Delete())" Class="cmd-btn">Delete</FluentButton>
</div>

@if (_loading)
{
    <div class="loading-container">
        <FluentProgressRing />
        <span>Loading index...</span>
    </div>
}
else if (_index == null)
{
    <div class="empty-state">
        <h3>Index not found</h3>
        <p>The index "@Name" was not found.</p>
        <FluentButton Appearance="Appearance.Accent" OnClick="@(() => Navigation.NavigateTo("/indexes"))">Back to indexes</FluentButton>
    </div>
}
else
{
    @* ── Stats Bar (like Azure portal) ── *@
    <div class="idx-stats-bar">
        <div class="idx-stat">
            <span class="idx-stat-label">Documents <FluentIcon Value="@(new RegularIcons.Size12.Info())" Color="Color.Neutral" /></span>
            <span class="idx-stat-value">@(_stats?.DocumentCount.ToString("N0") ?? "0")</span>
        </div>
        <div class="idx-stat">
            <span class="idx-stat-label">Total storage <FluentIcon Value="@(new RegularIcons.Size12.Info())" Color="Color.Neutral" /></span>
            <span class="idx-stat-value">@FormatBytes(_stats?.StorageSize ?? 0)</span>
        </div>
        <div class="idx-stat">
            <span class="idx-stat-label">Vector index quota usage <FluentIcon Value="@(new RegularIcons.Size12.Info())" Color="Color.Neutral" /></span>
            <span class="idx-stat-value">@FormatBytes(_stats?.VectorIndexSize ?? 0)</span>
        </div>
        <div class="idx-stat">
            <span class="idx-stat-label">Max storage <FluentIcon Value="@(new RegularIcons.Size12.Info())" Color="Color.Neutral" /></span>
            <span class="idx-stat-value">50 MB</span>
        </div>
    </div>

    @* ── Tabs ── *@
    <FluentTabs @bind-ActiveTabId="_activeTab" Style="margin-top: 4px;">
        @* ── Search Explorer Tab ── *@
        <FluentTab Label="Search explorer" Id="search">
            <div class="idx-search-tab">
                @* Query options & View links *@
                <div class="idx-search-controls">
                    <FluentButton Appearance="Appearance.Stealth" OnClick="@(() => _showQueryOptions = !_showQueryOptions)"
                                  IconStart="@(new RegularIcons.Size16.Settings())" Class="cmd-btn">Query options</FluentButton>
                    <FluentButton Appearance="Appearance.Stealth"
                                  IconStart="@(new RegularIcons.Size16.Eye())" Class="cmd-btn">View</FluentButton>
                </div>

                @* Search bar *@
                <div class="idx-search-bar">
                    <div class="idx-search-input-wrapper">
                        <FluentIcon Value="@(new RegularIcons.Size16.Search())" Color="Color.Neutral" Class="idx-search-icon" />
                        <input type="text" class="idx-search-input" @bind="_searchText" @bind:event="oninput"
                               @onkeydown="HandleSearchKeyDown" placeholder="*" />
                        @if (!string.IsNullOrEmpty(_searchText) && _searchText != "*")
                        {
                            <button class="idx-search-clear" @onclick="ClearSearch" title="Clear">✕</button>
                        }
                    </div>
                    <FluentButton Appearance="Appearance.Accent" OnClick="@ExecuteSearchAsync"
                                  Style="min-width: 80px;">Search</FluentButton>
                </div>

                @* Query options panel *@
                @if (_showQueryOptions)
                {
                    <div class="idx-query-options">
                        <div class="idx-qopt-grid">
                            <div>
                                <label class="idx-qopt-label">$filter</label>
                                <FluentTextField @bind-Value="_filter" Placeholder="e.g. rating gt 4" Style="width:100%;" />
                            </div>
                            <div>
                                <label class="idx-qopt-label">$orderby</label>
                                <FluentTextField @bind-Value="_orderBy" Placeholder="e.g. name asc" Style="width:100%;" />
                            </div>
                            <div>
                                <label class="idx-qopt-label">$select</label>
                                <FluentTextField @bind-Value="_select" Placeholder="e.g. name,description" Style="width:100%;" />
                            </div>
                            <div>
                                <label class="idx-qopt-label">$top</label>
                                <FluentNumberField @bind-Value="_top" Min="1" Max="1000" Style="width:100%;" />
                            </div>
                            <div>
                                <label class="idx-qopt-label">$skip</label>
                                <FluentNumberField @bind-Value="_skip" Min="0" Style="width:100%;" />
                            </div>
                            <div>
                                <label class="idx-qopt-label">$count</label>
                                <FluentCheckbox @bind-Value="_includeCount" Label="Include count" />
                            </div>
                            <div>
                                <label class="idx-qopt-label">searchMode</label>
                                <FluentSelect TOption="string" Items="@(new[] { "any", "all" })" @bind-Value="_searchMode"
                                              OptionValue="@(s => s)" OptionText="@(s => s)" Width="100%" />
                            </div>
                            <div>
                                <label class="idx-qopt-label">queryType</label>
                                <FluentSelect TOption="string" Items="@(new[] { "simple", "full" })" @bind-Value="_queryType"
                                              OptionValue="@(s => s)" OptionText="@(s => s)" Width="100%" />
                            </div>
                        </div>
                    </div>
                }

                @* Results *@
                @if (_searching)
                {
                    <div class="loading-container" style="padding: 30px;">
                        <FluentProgressRing />
                        <span>Searching...</span>
                    </div>
                }
                else if (_searchResult != null)
                {
                    <div class="idx-results">
                        <div class="idx-results-label">Results</div>
                        <div class="idx-json-container">
                            <div class="idx-json-lines">
                                @foreach (var line in _searchResultLines)
                                {
                                    <div class="idx-json-line">
                                        <span class="idx-line-num">@line.Number</span>
                                        <span class="idx-line-content">@((MarkupString)line.Html)</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </FluentTab>

        @* ── Fields Tab ── *@
        <FluentTab Label="Fields" Id="fields">
            <div style="margin-top: 16px;">
                @if (_index.Fields != null && _index.Fields.Any())
                {
                    <FluentDataGrid Items="@_index.Fields.AsQueryable()"
                                    GridTemplateColumns="1fr 150px 70px 90px 80px 80px 80px 90px"
                                    Style="width: 100%;">
                        <PropertyColumn Property="@(f => f.Name)" Title="Field name" />
                        <PropertyColumn Property="@(f => f.Type)" Title="Type" />
                        <TemplateColumn Title="Key" Align="Align.Center">
                            @if (context.Key) { <FluentIcon Value="@(new FilledIcons.Size16.CheckmarkCircle())" Color="Color.Success" /> }
                        </TemplateColumn>
                        <TemplateColumn Title="Searchable" Align="Align.Center">
                            @if (context.Searchable == true) { <FluentIcon Value="@(new FilledIcons.Size16.Checkmark())" Color="Color.Neutral" /> }
                        </TemplateColumn>
                        <TemplateColumn Title="Filterable" Align="Align.Center">
                            @if (context.Filterable == true) { <FluentIcon Value="@(new FilledIcons.Size16.Checkmark())" Color="Color.Neutral" /> }
                        </TemplateColumn>
                        <TemplateColumn Title="Sortable" Align="Align.Center">
                            @if (context.Sortable == true) { <FluentIcon Value="@(new FilledIcons.Size16.Checkmark())" Color="Color.Neutral" /> }
                        </TemplateColumn>
                        <TemplateColumn Title="Facetable" Align="Align.Center">
                            @if (context.Facetable == true) { <FluentIcon Value="@(new FilledIcons.Size16.Checkmark())" Color="Color.Neutral" /> }
                        </TemplateColumn>
                        <TemplateColumn Title="Retrievable" Align="Align.Center">
                            @if (context.Retrievable == true) { <FluentIcon Value="@(new FilledIcons.Size16.Checkmark())" Color="Color.Neutral" /> }
                        </TemplateColumn>
                    </FluentDataGrid>
                }
                else
                {
                    <p style="color: #605e5c;">No fields defined.</p>
                }
            </div>
        </FluentTab>

        @* ── CORS Tab ── *@
        <FluentTab Label="CORS" Id="cors">
            <div style="margin-top: 16px; color: #605e5c;">
                <p>Cross-Origin Resource Sharing (CORS) allows client-side code from different origins to access the search index.</p>
                <p>No CORS rules are currently configured for this index.</p>
            </div>
        </FluentTab>

        @* ── Scoring Profiles Tab ── *@
        <FluentTab Label="Scoring profiles" Id="scoring">
            <div style="margin-top: 16px;">
                @if (_index.ScoringProfiles != null && _index.ScoringProfiles.Any())
                {
                    <p style="color: #605e5c;">@_index.ScoringProfiles.Count scoring profile(s) defined.</p>
                }
                else
                {
                    <p style="color: #605e5c;">No scoring profiles defined.</p>
                }
            </div>
        </FluentTab>

        @* ── Semantic Configurations Tab ── *@
        <FluentTab Label="Semantic configurations" Id="semantic">
            <div style="margin-top: 16px; color: #605e5c;">
                <p>No semantic configurations defined for this index.</p>
            </div>
        </FluentTab>

        @* ── Vector Profiles Tab ── *@
        <FluentTab Label="Vector profiles" Id="vectors">
            <div style="margin-top: 16px;">
                @if (_vectorJsonLines.Any())
                {
                    <p style="color: #605e5c;">Vector search is configured for this index.</p>
                    <div class="idx-json-container" style="max-height: 400px; margin-top: 8px;">
                        <div class="idx-json-lines">
                            @foreach (var line in _vectorJsonLines)
                            {
                                <div class="idx-json-line">
                                    <span class="idx-line-num">@line.Number</span>
                                    <span class="idx-line-content">@((MarkupString)line.Html)</span>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <p style="color: #605e5c;">No vector profiles configured.</p>
                }
            </div>
        </FluentTab>

        @* ── JSON Definition Tab (Edit JSON) ── *@
        <FluentTab Label="JSON definition" Id="json">
            <div style="margin-top: 16px;">
                <div class="idx-json-container" style="max-height: 600px;">
                    <div class="idx-json-lines">
                        @foreach (var line in _rawJsonLines)
                        {
                            <div class="idx-json-line">
                                <span class="idx-line-num">@line.Number</span>
                                <span class="idx-line-content">@((MarkupString)line.Html)</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </FluentTab>
    </FluentTabs>
}

@* ── Delete Confirmation ── *@
<FluentDialog @bind-Hidden="@_hideDelete" Modal="true" TrapFocus="true">
    <FluentDialogHeader>Delete index</FluentDialogHeader>
    <FluentDialogBody>
        <p>Are you sure you want to delete index <strong>@Name</strong>? This action cannot be undone. All documents in this index will be permanently deleted.</p>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Accent" OnClick="DeleteIndexAsync"
                      style="background: #a80000; border-color: #a80000;">Delete</FluentButton>
        <FluentButton Appearance="Appearance.Outline" OnClick="@(() => _showDelete = false)">Cancel</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

@if (!string.IsNullOrEmpty(_error))
{
    <FluentMessageBar Intent="MessageIntent.Error" Title="Error">@_error</FluentMessageBar>
}

@code {
    [Parameter] public string Name { get; set; } = string.Empty;

    private bool _loading = true;
    private string? _error;
    private SearchIndexModel? _index;
    private IndexStatisticsModel? _stats;
    private string? _rawJson;
    private string _activeTab = "search";

    // Search explorer state
    private string _searchText = "*";
    private string? _filter;
    private string? _orderBy;
    private string? _select;
    private int _top = 50;
    private int _skip = 0;
    private bool _includeCount = true;
    private string _searchMode = "any";
    private string _queryType = "simple";
    private bool _showQueryOptions;
    private bool _searching;
    private string? _searchResult;
    private List<JsonLine> _searchResultLines = [];
    private List<JsonLine> _rawJsonLines = [];
    private List<JsonLine> _vectorJsonLines = [];

    // Delete state
    private bool _showDelete;
    private bool _hideDelete { get => !_showDelete; set => _showDelete = !value; }

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            _index = await ApiClient.GetIndexAsync(Name);
            _stats = await ApiClient.GetIndexStatsAsync(Name);

            var raw = await ApiClient.GetRawJsonAsync($"/indexes/{Name}");
            try
            {
                var doc = JsonDocument.Parse(raw);
                _rawJson = JsonSerializer.Serialize(doc, new JsonSerializerOptions { WriteIndented = true });
            }
            catch
            {
                _rawJson = raw;
            }
            _rawJsonLines = BuildHighlightedLines(_rawJson);

            if (_index?.VectorSearch != null)
            {
                var vectorJson = JsonSerializer.Serialize(_index.VectorSearch, new JsonSerializerOptions { WriteIndented = true });
                _vectorJsonLines = BuildHighlightedLines(vectorJson);
            }
            else
            {
                _vectorJsonLines.Clear();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ExecuteSearchAsync();
    }

    private async Task ExecuteSearchAsync()
    {
        _searching = true;
        _error = null;
        StateHasChanged();

        try
        {
            var body = new Dictionary<string, object>
            {
                ["search"] = string.IsNullOrWhiteSpace(_searchText) ? "*" : _searchText,
                ["count"] = _includeCount,
                ["top"] = _top,
                ["skip"] = _skip,
                ["searchMode"] = _searchMode,
                ["queryType"] = _queryType
            };

            if (!string.IsNullOrWhiteSpace(_filter)) body["filter"] = _filter;
            if (!string.IsNullOrWhiteSpace(_orderBy)) body["orderby"] = _orderBy;
            if (!string.IsNullOrWhiteSpace(_select)) body["select"] = _select;

            var json = JsonSerializer.Serialize(body, new JsonSerializerOptions { WriteIndented = true });
            var result = await ApiClient.SearchDocumentsAsync(Name, json);
            FormatSearchResult(result);
        }
        catch (Exception ex)
        {
            _error = $"Search failed: {ex.Message}";
        }
        finally
        {
            _searching = false;
        }
    }

    private void FormatSearchResult(string result)
    {
        try
        {
            var doc = JsonDocument.Parse(result);
            _searchResult = JsonSerializer.Serialize(doc, new JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            _searchResult = result;
        }

        _searchResultLines = BuildHighlightedLines(_searchResult);
    }

    private static List<JsonLine> BuildHighlightedLines(string? json)
    {
        var result = new List<JsonLine>();
        if (string.IsNullOrEmpty(json)) return result;

        var lines = json.Split('\n');
        for (int i = 0; i < lines.Length; i++)
        {
            result.Add(new JsonLine { Number = i + 1, Html = SyntaxHighlight(lines[i]) });
        }
        return result;
    }

    private static string SyntaxHighlight(string line)
    {
        // Escape HTML first
        var escaped = line
            .Replace("&", "&amp;")
            .Replace("<", "&lt;")
            .Replace(">", "&gt;");

        // Highlight JSON keys: "key":
        escaped = Regex.Replace(escaped,
            @"(&quot;|"")(.*?)(&quot;|"")\s*:",
            "<span class=\"json-key\">&quot;$2&quot;</span>:");

        // Highlight string values: "value" (not followed by a colon)
        escaped = Regex.Replace(escaped,
            @":\s*(&quot;|"")(.*?)(&quot;|"")",
            ": <span class=\"json-string\">&quot;$2&quot;</span>");

        // Highlight standalone strings in arrays
        escaped = Regex.Replace(escaped,
            @"^\s*(&quot;|"")(.*?)(&quot;|"")\s*,?\s*$",
            m => m.Value.Contains("json-key") || m.Value.Contains("json-string")
                ? m.Value
                : $"<span class=\"json-string\">{m.Value}</span>");

        // Highlight numbers
        escaped = Regex.Replace(escaped,
            @":\s*(\d+\.?\d*)",
            ": <span class=\"json-number\">$1</span>");

        // Highlight booleans and null
        escaped = Regex.Replace(escaped,
            @":\s*(true|false|null)",
            ": <span class=\"json-bool\">$1</span>");

        return escaped;
    }

    private void ClearSearch()
    {
        _searchText = "*";
        _searchResult = null;
        _searchResultLines.Clear();
    }

    private void ConfirmDelete() => _showDelete = true;

    private async Task DeleteIndexAsync()
    {
        try
        {
            await ApiClient.DeleteIndexAsync(Name);
            Navigation.NavigateTo("/indexes");
        }
        catch (Exception ex)
        {
            _error = $"Failed to delete: {ex.Message}";
            _showDelete = false;
        }
    }

    private string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F2} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024.0):F2} MB";
        return $"{bytes / (1024.0 * 1024.0 * 1024.0):F2} GB";
    }

    private class JsonLine
    {
        public int Number { get; set; }
        public string Html { get; set; } = string.Empty;
    }
}
