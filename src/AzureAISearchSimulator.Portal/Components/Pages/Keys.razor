@page "/keys"
@inject SearchSimulatorApiClient ApiClient
@inject IJSRuntime JS

<PageTitle>Keys - Azure AI Search Simulator</PageTitle>

<div class="page-header">
    <h1>Keys</h1>
</div>

<div class="detail-section">
    <p style="color: #605e5c; margin-bottom: 20px;">
        Use API keys to authenticate requests to your search service.
        Admin keys grant full access to all operations. Query keys grant read-only access for search queries.
    </p>

    @* ── Endpoint ── *@
    <div style="margin-bottom: 24px;">
        <h2>Endpoint</h2>
        <div style="display: flex; align-items: center; gap: 8px; margin-top: 8px;">
            <span class="key-value" style="flex: 1;">@ApiClient.BaseUrl</span>
            <FluentButton Appearance="Appearance.Outline" Title="Copy" OnClick="@(() => CopyToClipboard(ApiClient.BaseUrl))"
                          IconStart="@(new RegularIcons.Size16.Copy())">Copy</FluentButton>
        </div>
    </div>

    @* ── Admin API Key ── *@
    <div style="margin-bottom: 24px;">
        <h2>Admin API key</h2>
        <p style="font-size: 12px; color: #605e5c; margin-bottom: 8px;">
            Admin keys provide full access to all content operations including the ability to manage indexes, indexers, and data sources.
        </p>
        <div style="display: flex; align-items: center; gap: 8px; margin-top: 8px;">
            @if (_showAdminKey)
            {
                <span class="key-value" style="flex: 1;">@ApiClient.AdminApiKey</span>
            }
            else
            {
                <span class="key-value" style="flex: 1;">••••••••••••••••••••••••••••••••</span>
            }
            <FluentButton Appearance="Appearance.Outline" Title="@(_showAdminKey ? "Hide" : "Show")"
                          OnClick="@(() => _showAdminKey = !_showAdminKey)"
                          IconStart="@(_showAdminKey ? new RegularIcons.Size16.EyeOff() : new RegularIcons.Size16.Eye())">
                @(_showAdminKey ? "Hide" : "Show")
            </FluentButton>
            <FluentButton Appearance="Appearance.Outline" Title="Copy" OnClick="@(() => CopyToClipboard(ApiClient.AdminApiKey))"
                          IconStart="@(new RegularIcons.Size16.Copy())">Copy</FluentButton>
        </div>
    </div>

    @* ── Query API Key ── *@
    <div style="margin-bottom: 24px;">
        <h2>Query API key</h2>
        <p style="font-size: 12px; color: #605e5c; margin-bottom: 8px;">
            Query keys provide read-only access to indexes and documents, and are typically distributed to client applications that issue search requests.
        </p>
        <div style="display: flex; align-items: center; gap: 8px; margin-top: 8px;">
            @if (_showQueryKey)
            {
                <span class="key-value" style="flex: 1;">@ApiClient.QueryApiKey</span>
            }
            else
            {
                <span class="key-value" style="flex: 1;">••••••••••••••••••••••••••••••••</span>
            }
            <FluentButton Appearance="Appearance.Outline" Title="@(_showQueryKey ? "Hide" : "Show")"
                          OnClick="@(() => _showQueryKey = !_showQueryKey)"
                          IconStart="@(_showQueryKey ? new RegularIcons.Size16.EyeOff() : new RegularIcons.Size16.Eye())">
                @(_showQueryKey ? "Hide" : "Show")
            </FluentButton>
            <FluentButton Appearance="Appearance.Outline" Title="Copy" OnClick="@(() => CopyToClipboard(ApiClient.QueryApiKey))"
                          IconStart="@(new RegularIcons.Size16.Copy())">Copy</FluentButton>
        </div>
    </div>

    @* ── Usage Hints ── *@
    <div class="essentials-panel">
        <h3 style="margin-bottom: 12px;">Quick reference</h3>
        <div style="font-size: 13px; color: #323130;">
            <p style="margin-bottom: 8px;"><strong>Header-based authentication:</strong></p>
            <div class="json-viewer" style="font-size: 12px; max-height: 120px;">api-key: &lt;your-admin-or-query-key&gt;</div>

            <p style="margin-top: 16px; margin-bottom: 8px;"><strong>Example search request:</strong></p>
            <div class="json-viewer" style="font-size: 12px; max-height: 150px;">POST @(ApiClient.BaseUrl)/indexes/&lt;index-name&gt;/docs/search?api-version=2024-07-01
Content-Type: application/json
api-key: @(ApiClient.QueryApiKey)

{
  "search": "*",
  "count": true
}</div>
        </div>
    </div>
</div>

@if (_copied)
{
    <FluentMessageBar Intent="MessageIntent.Success" Title="Copied" Style="position: fixed; bottom: 16px; right: 16px; z-index: 1000;">
        Value copied to clipboard.
    </FluentMessageBar>
}

@code {
    private bool _showAdminKey;
    private bool _showQueryKey;
    private bool _copied;

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            _copied = true;
            StateHasChanged();

            await Task.Delay(2000);
            _copied = false;
            StateHasChanged();
        }
        catch
        {
            // Clipboard API may not be available in all contexts
        }
    }
}
